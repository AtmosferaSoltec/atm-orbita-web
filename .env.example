# Public settings, read at build time (src/env.ts).

# Base URL of atm-auth-api: login, register, refresh, logout, password recovery,
# Google sign-in and account deletion. Default: https://auth.atmosferast.com/v1
PUBLIC_AUTH_API_URL=https://auth.atmosferast.com/v1

# Google OAuth web client ID for "Continuar con Google". Empty hides the button.
PUBLIC_GOOGLE_CLIENT_ID=
